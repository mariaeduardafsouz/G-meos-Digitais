{
  "version": 1,
  "author": "pH Gemeo Digital - Projeto Academico",
  "editor": "wokwi",
  "parts": [
    {
      "type": "wokwi-esp32-devkit-v1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-lcd1602",
      "id": "lcd",
      "top": -110,
      "left": 260,
      "attrs": {
        "pins": "i2c",
        "address": "0x27"
      }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot1",
      "top": 170,
      "left": -120,
      "attrs": {
        "label": "Sensor de pH (Analogico)",
        "value": "2048"
      }
    },
    {
      "type": "wokwi-led",
      "id": "ledGreen",
      "top": 80,
      "left": 380,
      "attrs": {
        "color": "green",
        "label": "OK"
      }
    },
    {
      "type": "wokwi-led",
      "id": "ledYellow",
      "top": 130,
      "left": 380,
      "attrs": {
        "color": "yellow",
        "label": "ALERTA"
      }
    },
    {
      "type": "wokwi-led",
      "id": "ledRed",
      "top": 180,
      "left": 380,
      "attrs": {
        "color": "red",
        "label": "FALHA"
      }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 80,
      "left": 330,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r2",
      "top": 130,
      "left": 330,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r3",
      "top": 180,
      "left": 330,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    ["esp:TX0", "$serialMonitor:RX", "", []],
    ["esp:RX0", "$serialMonitor:TX", "", []],

    ["esp:VIN",  "lcd:VCC", "red",   []],
    ["esp:GND.1","lcd:GND", "black", []],
    ["esp:D21",  "lcd:SDA", "blue",  []],
    ["esp:D22",  "lcd:SCL", "green", []],

    ["pot1:VCC", "esp:3V3",  "red",   []],
    ["pot1:GND", "esp:GND.1","black", []],
    ["pot1:SIG", "esp:D34",  "orange",[]],

    ["esp:D25",  "r1:1",    "green", []],
    ["r1:2",     "ledGreen:A","green",[]],
    ["ledGreen:C","esp:GND.1","black",[]],

    ["esp:D26",  "r2:1",    "yellow",[]],
    ["r2:2",     "ledYellow:A","yellow",[]],
    ["ledYellow:C","esp:GND.1","black",[]],

    ["esp:D27",  "r3:1",    "red",   []],
    ["r3:2",     "ledRed:A","red",   []],
    ["ledRed:C", "esp:GND.1","black", []]
  ],
  "serialMonitor": {
    "display": "always",
    "newline": "lf"
  }
}
